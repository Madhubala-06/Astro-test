---
import { sanityClient } from '../lib/sanity';
import Twitter from 'lucide-astro/Twitter';
import Linkedin from 'lucide-astro/Linkedin';
import Github from 'lucide-astro/Github';
import Instagram from 'lucide-astro/Instagram';
import Link from 'lucide-astro/Link';

const landingPage = await sanityClient.fetch(`
  *[_type == "landingPage"][0] {
    footerTagline,
    socialLinks
  }
`);

const currentYear = new Date().getFullYear();

const getSocialIcon = (platform: string) => {
  switch (platform) {
    case 'twitter': return Twitter;
    case 'linkedin': return Linkedin;
    case 'github': return Github;
    case 'instagram': return Instagram;
    default: return Link;
  }
};
---

<footer class="bg-slate-900 border-t border-slate-700 text-white lg:ml-80">
  <div class="px-8 py-12">
    <div class="max-w-7xl">
      <div class="grid md:grid-cols-4 gap-8 mb-8">
        <!-- Brand -->
        <div>
          <h3 class="text-2xl font-bold text-orange-500 mb-3">
            Bilog
          </h3>
          <p class="text-gray-400 text-sm leading-relaxed">
            {landingPage?.footerTagline || 'Travel • Tech • Design'}
          </p>
        </div>

        <!-- Quick Links -->
        <div>
          <h4 class="font-semibold text-white mb-4">Quick Links</h4>
          <ul class="space-y-2">
            <li><a href="/" class="text-gray-400 hover:text-orange-500 transition-colors text-sm">Home</a></li>
            <li><a href="/blog" class="text-gray-400 hover:text-orange-500 transition-colors text-sm">Blog</a></li>
            <li><a href="/photography" class="text-gray-400 hover:text-orange-500 transition-colors text-sm">Photography</a></li>
          </ul>
        </div>

        <div>
          <h4 class="font-semibold text-white mb-4">Categories</h4>
          <ul class="space-y-2">
            <li><a href="/blog?category=travel" class="text-gray-400 hover:text-orange-500 transition-colors text-sm">Must Visit Places</a></li>
            <li><a href="/blog?category=food" class="text-gray-400 hover:text-orange-500 transition-colors text-sm">Must Try Things</a></li>
            <li><a href="/blog?category=technology" class="text-gray-400 hover:text-orange-500 transition-colors text-sm">Tech Tips</a></li>
            <li><a href="/blog?category=personal" class="text-gray-400 hover:text-orange-500 transition-colors text-sm">Life &amp; Experiences</a></li>
          </ul>
        </div>

        <div>
          <h4 class="font-semibold text-white mb-4">Connect</h4>
          <div class="flex gap-3">
            {landingPage?.socialLinks && landingPage.socialLinks.length > 0 ? (
              landingPage.socialLinks.map((link: any) => {
                const IconComponent = getSocialIcon(link.platform);
                return (
                  <a 
                    href={link.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="w-10 h-10 bg-slate-800 border border-slate-700 rounded-lg flex items-center justify-center hover:bg-orange-500 hover:border-orange-500 hover:scale-110 transition-all duration-300 text-gray-400 hover:text-white"
                    title={link.platform}
                    aria-label={link.platform}
                  >
                    <IconComponent size={20} />
                  </a>
                );
              })
            ) : (
              <a
                href="https://github.com/Madhubala-06"
                target="_blank"
                rel="noopener noreferrer"
                aria-label="GitHub"
                class="w-10 h-10 bg-slate-800 border border-slate-700 rounded-lg flex items-center justify-center hover:bg-orange-500 hover:border-orange-500 hover:scale-110 transition-all duration-300 text-gray-400 hover:text-white"
              >
                <Github size={20} />
              </a>
            )}
          </div>
        </div>
      </div>

      <div class="pt-8 border-t border-slate-700">
        <p class="text-gray-500 text-sm text-center">
          © {currentYear} Bilog. Built with 💜 using Astro & Sanity.
        </p>
      </div>
    </div>
  </div>
</footer>
