---
// Layout Component - Shared across all pages
import '../styles/global.css';

interface Props {
  title?: string;
}

const { title = 'Bilog' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>

    <!-- SEO Meta Tags -->
    <meta name="description" content="Bilog pricing" />
  </head>
  <body class="bg-white text-gray-900 antialiased">
    <!-- Navigation (can be extracted to component) -->
    <nav class="border-b border-gray-100">
      <div class="container mx-auto px-4 py-4 flex justify-between items-center">
        <a href="/" class="text-xl font-bold">Bilog</a>
        <div class="flex gap-6">
          <a href="/" class="text-gray-600 hover:text-gray-900">Home</a>
          <a href="/blog" class="text-gray-600 hover:text-gray-900">Blog</a>
          <a href="/photography" class="text-gray-600 hover:text-gray-900">Photography</a>
          <a href="/pricing" class="text-gray-900 font-semibold" aria-current="page">Pricing</a>
        </div>
      </div>
    </nav>

    <!-- Main Content -->
    <slot />

    <!-- Footer -->
    <footer class="bg-gray-900 text-white py-12">
      <div class="container mx-auto px-4 text-center">
        <p>&copy; {new Date().getFullYear()} Bilog.</p>
      </div>
    </footer>
  </body>
</html>
